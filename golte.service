[Unit]
Description=Golte - GSM/LTE to Discord Bridge
Documentation=https://github.com/yewolf/golte
After=pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=/opt/golte
ExecStartPre=/bin/sleep 30
ExecStart=/opt/golte/golte --config /opt/golte/config.yaml
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=golte

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/golte

# Environment
Environment=GOLTE_LOGGING_LEVEL=info
Environment=GOLTE_LOGGING_FORMAT=json

# Resource limits
LimitNOFILE=65536
MemoryMax=256M

[Install]
WantedBy=default.target
